# Example .env file - Copy this to .env and fill in your actual values

# Hugging Face API Tokens
HF_TOKEN=hf_your_actual_token_here
HF_TOKEN_SECONDARY=hf_your_backup_token_here

# Google OAuth Configuration (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_actual_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_actual_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501

# Admin Configuration
ADMIN_EMAIL=your_admin_email@gmail.com

# Security
SECRET_KEY=your_secret_key_here
SESSION_TIMEOUT=3600
ENABLE_SECURITY_HEADERS=true
ENABLE_CSRF_PROTECTION=true

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=20
MAX_TOKENS_PER_REQUEST=2500